node_modules
dist
.DS_Store
*.local
__pycache__/

# Video. Raw camera/editor files stay local — they are large, and the
# processed versions are what the site serves.
*.mp4
*.mov
*.avi
*.webm
*.mkv

# ...except the encoded delivery clips, which MUST ship. Vite copies public/
# into dist/, so anything here that git does not carry is missing from a
# fresh clone and 404s on deploy while still working on the machine that
# encoded it. Produced by scripts/encode-video.mjs from assets/ — see
# src/data/video.js for how they are referenced.
!public/video/
!public/video/*.webm
!public/video/*.mp4

# raw source assets — processed versions live in public/, source stays local
assets/
# but the processed images that Vite copies from public/ must ship
!public/assets/
!public/assets/**
.vercel

# public/img/content/ IS COMMITTED — do not add it back here.
#
# It used to be generated: images lived as data: URLs in the snapshot and the
# extract step rebuilt these files on every deploy. That made the publish
# request grow with every upload until it broke at the ~4.5 MB body limit.
# /admin now commits each image here as its own file and the snapshot stores
# only paths (see src/lib/publish.jsx). These files are the images — ignoring
# them would 404 every picture on the site.
#
# Still generated, still derived from src/data/content.snapshot.json:
src/data/content.snapshot.built.json
