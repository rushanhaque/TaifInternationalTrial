{
  "name": "taif-international",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prep": "node scripts/extract-content-images.mjs",
    "images:webp": "node scripts/to-webp.mjs && node scripts/repoint-webp.mjs",
    "images:check": "node scripts/check-image-refs.mjs",
    "video": "node scripts/encode-video.mjs",
    "dev": "npm run prep && vite",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "build": "npm run prep && node scripts/gen-sitemap.mjs && vite build",
    "preview": "vite preview",
    "finishes": "node scripts/encode-finishes.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.13.0",
    "lenis": "^1.1.18",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.3",
    "vite": "^5.4.11"
  }
